# ========================================================
# Configurações do Banco de Dados MySQL para Produção (Vercel)
# ========================================================
# Você pode utilizar tanto as variáveis individuais quanto a URL de conexão completa.

# Opção 1: Variáveis Individuais (ex: Railway, Aiven, TiDB, Clever Cloud)
DB_HOST=seu-host-mysql.com
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_NAME=monsenhor_bicudo
DB_PORT=3306
DB_SSL=true

# Opção 2: URL de Conexão (se o provedor fornecer connection string)
# DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco?sslmode=require
